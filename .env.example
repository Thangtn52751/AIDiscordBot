DISCORD_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DISCORD_GUILD_ID=
FACEIT_API_KEY=

# Required on Vercel; optional locally (otherwise birthdays use data/birthdays.json).
# Use the Redis TCP/TLS URL, not an Upstash REST URL.
REDIS_URL=
BIRTHDAY_REDIS_KEY=aidiscordbot:birthdays:v1
BIRTHDAY_TIMEZONE=Asia/Bangkok

# Dockerfile.bot sets BOT_HOST=vercel automatically.
BOT_HOST=local
