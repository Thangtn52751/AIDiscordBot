DISCORD_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DISCORD_GUILD_ID=
FACEIT_API_KEY=

# Required on Vercel to prevent overlapping bot instances; optional locally.
# Use the Redis TCP/TLS URL, not an Upstash REST URL.
REDIS_URL=

# Dockerfile.bot sets BOT_HOST=vercel automatically.
BOT_HOST=local
